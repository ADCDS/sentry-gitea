# BEGIN sentry-gitea
SENTRY_DEFAULT_INTEGRATIONS += (
    "sentry_gitea.integration.provider.GiteaIntegrationProvider",
)
ROOT_URLCONF = "sentry_gitea.urls"
# Like Sentry's own SCM search endpoints, exempt from the DEBUG-only pagination check.
SENTRY_API_PAGINATION_ALLOWLIST = set(SENTRY_API_PAGINATION_ALLOWLIST) | {"GiteaSearchEndpoint"}
# Registers the push-backfill and OAuth keep-alive tasks (integrations namespace) in web,
# worker and scheduler.
TASKWORKER_IMPORTS = (*TASKWORKER_IMPORTS, "sentry_gitea.integration.tasks")
# Keeps idle installations authorized: Gitea refresh tokens expire after
# REFRESH_TOKEN_EXPIRATION_TIME (730 h by default) unless used. Run by the taskscheduler service.
from datetime import timedelta
TASKWORKER_SCHEDULES["gitea-identity-refresh"] = {
    "task": "integrations:sentry_gitea.integration.refresh_identities",
    "schedule": timedelta(hours=12),
}
# Organization integration OAuth settings: literal values, the same for web and workers.
# GITEA_BASE_URL = "http://gitea:3000"  # how Sentry's containers reach Gitea
# GITEA_PUBLIC_URL = "https://gitea.example.com"  # how browsers reach Gitea (optional)
# GITEA_CLIENT_ID = "<OAuth2 application client ID>"
# GITEA_CLIENT_SECRET = "<OAuth2 application client secret>"
# Optional: base URL Gitea uses to reach Sentry for repository webhooks
# (<prefix>/extensions/gitea/webhook/<integration id>/<repository id>/). Defaults to
# system.url-prefix; prefer Sentry's public URL.
# GITEA_WEBHOOK_URL_PREFIX = "https://sentry.example.com"
# END sentry-gitea
